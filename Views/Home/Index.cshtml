@model DriverTrustDashboardViewModel

@{
    ViewData["Title"] = "Verify a Driver";
}

<section class="hero-panel landing-hero" id="verify">
    <div class="hero-panel__copy">
        <span class="eyebrow">Driver reputation marketplace</span>
        <h1>Verify the driver before the trip, contract, or hire.</h1>
        <p>
            Search verified driver profiles, read structured public feedback, and compare trust signals across rideshare,
            delivery, trucking, and fleet work.
        </p>
        <form class="search-card" role="search" data-verify-url="@Url.Action("Verify", "Home")">
            <label for="driver-search">Driver, vehicle, platform, or region</label>
            <div class="search-card__row">
                <input id="driver-search" type="search" placeholder="Search: Thabo Mokoena, GP 42 MX, Bolt, Durban" />
                <button type="submit">Search</button>
            </div>
            <p class="search-card__status" data-search-status>Try a driver name, registration, platform, or city.</p>
        </form>
    </div>

    <aside class="trust-card result-panel is-empty" data-profile-panel aria-live="polite" aria-label="Verification result profile">
        <div>
            <span class="status-pill status-pill--verified" data-profile-status>Awaiting search</span>
            <h2 data-profile-name>No profile selected</h2>
            <p data-profile-meta>Verify a driver, vehicle, platform, or partner to reveal linked details.</p>
        </div>
        <dl class="trust-metrics">
            <div>
                <dt>Trust</dt>
                <dd data-profile-trust>--</dd>
            </div>
            <div>
                <dt>Reports</dt>
                <dd data-profile-reports>--</dd>
            </div>
            <div>
                <dt>Risk</dt>
                <dd data-profile-risk>--</dd>
            </div>
        </dl>
        <div class="linked-entities" data-profile-links></div>
    </aside>
</section>

<section class="landing-grid">
    <section class="feed" id="feed" aria-label="Driver trust activity feed">
        <div class="section-heading">
            <span class="eyebrow">Community feedback</span>
            <h2>Community feed</h2>
        </div>

        <div class="empty-state" data-feed-empty>
            <h3>No verification loaded yet</h3>
            <p>Community feedback will appear here after a driver or linked entity is verified.</p>
        </div>
        <div class="feed-results" data-feed-results></div>
    </section>

    <article class="report-composer">
        <div class="section-heading">
            <span class="eyebrow">Structured contribution</span>
            <h2>Submit a driver signal</h2>
        </div>
        <form class="signal-form" data-signal-form>
            <label>
                Category
                <select data-signal-category>
                    <option>Safety or road conduct</option>
                    <option>Passenger or customer experience</option>
                    <option>Employer contract feedback</option>
                    <option>Vehicle condition</option>
                </select>
            </label>
            <label>
                Severity
                <input type="range" min="1" max="5" value="2" data-signal-severity />
            </label>
            <label>
                Context
                <textarea rows="4" placeholder="Summarize what happened, where it happened, and what should be reviewed." data-signal-context></textarea>
            </label>
            <p class="form-status" data-signal-status aria-live="polite">Structured signals are saved for moderation before they affect trust.</p>
            <div class="form-actions">
                <button type="button" data-signal-draft>Save draft</button>
                <button type="submit" class="button-strong">Submit for review</button>
            </div>
        </form>
    </article>
</section>
