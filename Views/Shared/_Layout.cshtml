<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Verify Driver</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="app-shell__topbar">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Verify Driver home">
            <span class="brand__mark">VD</span>
            <span class="brand__text">Verify Driver</span>
        </a>
        <nav class="topnav" aria-label="Primary navigation">
            <a asp-controller="Home" asp-action="Index">Home</a>
            @if (User.IsInRole("Driver") || User.IsInRole("Owner") || User.IsInRole("Fleet") || User.IsInRole("Platform") || User.IsInRole("Moderator") || User.IsInRole("Admin"))
            {
                <a asp-controller="Me" asp-action="Index">Me</a>
            }
            @if (User.IsInRole("Owner") || User.IsInRole("Fleet") || User.IsInRole("Platform") || User.IsInRole("Moderator") || User.IsInRole("Admin"))
            {
                <a asp-controller="Relationships" asp-action="Index">Relationships</a>
            }
            @if (User.IsInRole("Driver") || User.IsInRole("Owner") || User.IsInRole("Fleet") || User.IsInRole("Platform") || User.IsInRole("Moderator") || User.IsInRole("Admin"))
            {
                <a asp-controller="Verify" asp-action="Index">Verify</a>
            }
            @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index">Admin</a>
            }
        </nav>
        <span class="role-badge" aria-label="Current role scope">
            @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Moderator") ? "Moderator" : User.IsInRole("Owner") || User.IsInRole("Fleet") ? "Owner/Fleet" : User.IsInRole("Driver") ? "Driver" : "Public")
        </span>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark and light theme">
            <span data-theme-label>Dark</span>
        </button>
    </header>

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>Verify Driver marketplace</span>
        <span>Driver reputation, feedback, and verification for safer work decisions.</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
